From: John Idogun <sirneij@gmail.com>
Date: Sun, 27 Sep 2026 20:03:07 -0700
Subject: [PATCH 14/17] Add investigate_mariadb.py (finds pairs missing from
 MariaDB's closure)

---
 investigate_mariadb.py | 85 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 85 insertions(+)
 create mode 100644 investigate_mariadb.py

diff --git a/investigate_mariadb.py b/investigate_mariadb.py
new file mode 100644
index 00000000..af03c5d9
--- /dev/null
+++ b/investigate_mariadb.py
@@ -0,0 +1,85 @@
+"""Finds the pairs missing from MariaDB's transitive closure and tests whether max_recursive_iterations
+explains them. Usage: python investigate_mariadb.py <graph> <n> <left|right> [max_recursive_iterations]"""
+import getpass
+import json
+import os
+import sys
+import time
+from collections import deque, defaultdict
+
+import duckdb
+import MySQLdb
+
+graph, n, mode = sys.argv[1], int(sys.argv[2]), sys.argv[3]
+max_iter = int(sys.argv[4]) if len(sys.argv) > 4 else None
+edge_file = os.path.abspath(f'input/souffle/{graph}/{n}/edge.facts')
+rec = {'left': 'SELECT tc.x, edge.y FROM tc JOIN edge ON tc.y = edge.x',
+       'right': 'SELECT edge.x, tc.y FROM edge JOIN tc ON edge.y = tc.x'}[mode]
+out_file = '/tmp/mariadb_investigate.csv'
+if os.path.exists(out_file):
+    os.remove(out_file)
+
+c = MySQLdb.connect(db='benchmark', user=getpass.getuser(), unix_socket='/tmp/mysql.sock', local_infile=1)
+c.autocommit(True)
+cur = c.cursor()
+cur.execute(f"SET @@standard_compliant_cte={os.environ.get('STD_CTE', '0')}")  # harness uses 0
+if os.environ.get('TMP_BYTES'):
+    cur.execute(f"SET @@tmp_table_size={os.environ['TMP_BYTES']}")
+    cur.execute(f"SET @@max_heap_table_size={os.environ['TMP_BYTES']}")
+if max_iter:
+    cur.execute(f'SET @@max_recursive_iterations={max_iter}')
+cur.execute('SELECT @@max_recursive_iterations, @@standard_compliant_cte, @@tmp_table_size')
+settings = cur.fetchone()
+cur.execute('DROP TABLE IF EXISTS edge, tc_result')
+cur.execute('CREATE TABLE edge (x INTEGER NOT NULL, y INTEGER NOT NULL)')
+cur.execute(f"LOAD DATA LOCAL INFILE '{edge_file}' INTO TABLE edge FIELDS TERMINATED BY '\\t' LINES TERMINATED BY '\\n' (x, y)")
+cur.execute('CREATE INDEX edge_yx ON edge (y, x)')
+cur.execute('ANALYZE TABLE edge')
+cur.fetchall()
+t = time.perf_counter()
+cur.execute(f'CREATE TABLE tc_result AS WITH RECURSIVE tc AS (SELECT x, y FROM edge UNION {rec}) SELECT * FROM tc')
+elapsed = time.perf_counter() - t
+cur.execute('SHOW WARNINGS')
+warnings = cur.fetchall()
+cur.execute('SELECT COUNT(*) FROM tc_result')
+mariadb_count = cur.fetchone()[0]
+cur.execute(f"SELECT * FROM tc_result INTO OUTFILE '{out_file}' FIELDS TERMINATED BY ',' LINES TERMINATED BY '\\n'")
+cur.execute('DROP TABLE IF EXISTS edge, tc_result')
+c.close()
+
+# Reference closure (DuckDB, whose results on this input match the Python ground truth and all other
+# systems), and the pairs that MariaDB did not return.
+d = duckdb.connect()
+d.execute(f"CREATE TABLE edge AS SELECT * FROM read_csv('{edge_file}', delim='\t', header=false, columns={{'x':'INTEGER','y':'INTEGER'}})")
+d.execute(f'CREATE TABLE ref AS WITH RECURSIVE tc AS (SELECT x, y FROM edge UNION {rec}) SELECT * FROM tc')
+d.execute(f"CREATE TABLE got AS SELECT * FROM read_csv('{out_file}', delim=',', header=false, columns={{'x':'INTEGER','y':'INTEGER'}})")
+ref_count = d.execute('SELECT COUNT(*) FROM ref').fetchone()[0]
+missing = d.execute('SELECT x, y FROM ref EXCEPT SELECT x, y FROM got ORDER BY 1, 2').fetchall()
+extra = d.execute('SELECT x, y FROM got EXCEPT SELECT x, y FROM ref ORDER BY 1, 2').fetchall()
+dups = d.execute('SELECT COUNT(*) - COUNT(DISTINCT (x, y)) FROM got').fetchone()[0]
+
+# Shortest-path distance of each missing pair (= semi-naive iteration in which it is first derived).
+adj = defaultdict(list)
+for a, b in d.execute('SELECT DISTINCT x, y FROM edge').fetchall():
+    adj[a].append(b)
+
+
+def dist(s, t):
+    seen, q = {s: 0}, deque([s])
+    while q:
+        v = q.popleft()
+        for w in adj[v]:
+            if w not in seen:
+                seen[w] = seen[v] + 1
+                if w == t:
+                    return seen[w]
+                q.append(w)
+    return None
+
+
+diameter_hint = max((dist(x, y) or 0) for x, y in missing[:20]) if missing else None
+print(json.dumps({'graph': graph, 'n': n, 'mode': mode, 'settings': {'max_recursive_iterations': settings[0],
+       'standard_compliant_cte': settings[1], 'tmp_table_size': settings[2]}, 'query_s': round(elapsed, 1),
+       'warnings': [list(w) for w in warnings][:5], 'mariadb_rows': mariadb_count, 'reference_rows': ref_count,
+       'missing': [[x, y, dist(x, y)] for x, y in missing[:20]], 'n_missing': len(missing), 'n_extra': len(extra),
+       'duplicate_rows': dups}))
